{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",

    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": true,

    "jsx": "react-jsx",
    "jsxImportSource": "preact",

    "esModuleInterop": true,
    "resolveJsonModule": true,

    "skipLibCheck": true,
    "moduleDetection": "force"
  },

  "include": ["ui/static/js", "scripts/reconcile"],
  "exclude": ["ui/static/dist"]
}
