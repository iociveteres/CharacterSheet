{
  "permissions": {
    "deny": ["Read(ui/static/dist/**)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/limit-read.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
